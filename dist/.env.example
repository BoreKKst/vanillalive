# Скопируйте в .env и заполните. Файл .env НЕЛЬЗЯ публиковать и отправлять кому-либо.
DISCORD_TOKEN=PUT_YOUR_TOKEN_HERE
GUILD_ID=1565370345748299957
CHAT_CHANNEL_ID=1566008093349773422
CONSOLE_CHANNEL_ID=1566016032504680558

# Общий секрет бота и плагина, минимум 32 случайных символа.
BRIDGE_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
BRIDGE_PORT=8765
# 127.0.0.1 = принимать запросы только с этого ПК (через туннель cloudflared/ngrok и т.п.)
BRIDGE_BIND=127.0.0.1

# Консоль Nexuz (Pterodactyl Client API). Если PTERO_API_KEY пуст, консоль в Discord отключена.
